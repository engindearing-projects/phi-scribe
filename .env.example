# phi-scribe environment variables
# Copy to .env.local and fill in values as needed.

# Whisper CLI binary path (optional — auto-detected if whisper.cpp is in ~/whisper.cpp/)
# WHISPER_BIN=/Users/you/whisper.cpp/build/bin/whisper-cli

# Whisper model file path (optional — auto-detected from ~/whisper.cpp/models/)
# WHISPER_MODEL_PATH=/Users/you/whisper.cpp/models/ggml-base.bin

# Ollama URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Audit log path (default: ~/.phi-scribe/audit.db)
# AUDIT_DB_PATH=/Users/you/.phi-scribe/audit.db

# Cloud API keys — ONLY use these if you have a signed BAA with the provider
# and your compliance posture permits sending encounter data to them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
